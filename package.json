{
  "name": "ds-project",
  "version": "0.8.9",
  "private": true,
  "type": "module",
  "main": "runtime/v0.8.9/index.js",
  "files": [
    "runtime/v0.8.9",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./runtime/v0.8.9/index.js",
    "./package.json": "./package.json",
    "./client": "./runtime/v0.8.9/client.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.client.config.js",
    "test": "node --test test/*.test.js",
    "package": "npm run build && node scripts/third-party-notices.mjs && node scripts/stage-release.mjs && npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.5"
  },
  "description": "Local project conversations, parallel tasks and shared memory for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterTianbuhan/ds-project.git"
  },
  "homepage": "https://github.com/PeterTianbuhan/ds-project#readme",
  "bugs": {
    "url": "https://github.com/PeterTianbuhan/ds-project/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
